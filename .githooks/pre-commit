#!/usr/bin/env bash
set -euo pipefail

# Detect go binary location (handles non-standard PATH in hook context)
for gopath_candidate in "$(command -v go 2>/dev/null)" /usr/local/go/bin/go /usr/bin/go ~/go/bin/go; do
    if [ -x "$gopath_candidate" ]; then
        export PATH="$(dirname "$gopath_candidate"):$PATH"
        break
    fi
done

echo "→ go vet"
go vet ./...

echo "→ go build"
go build ./...

echo "→ go test (race)"
go test -race -count=1 ./...

echo "✓ pre-commit checks passed"
